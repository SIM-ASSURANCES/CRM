// Schéma du socle technique (phase 2). Les tables métier (prospects, opportunités…)
// seront ajoutées par migrations successives dans les phases 3 et 4.
// Conventions (CDC A.5) : UUID, timestamptz, tables en snake_case, pas de cascade sur l'historique.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identité et accès (tables gérées par Better Auth : user, session, account, verification)
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  name               String
  email              String    @unique
  emailVerified      Boolean   @default(false) @map("email_verified")
  image              String?
  // Rôle applicatif : admin | direction | manager | commercial | audit (voir src/lib/auth/roles.ts)
  role               String?   @default("commercial")
  banned             Boolean?  @default(false)
  banReason          String?   @map("ban_reason")
  banExpires         DateTime? @map("ban_expires") @db.Timestamptz(3)
  // Réinitialisation par l'administrateur : le mot de passe temporaire doit être changé à la connexion suivante
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  teamId             String?   @map("team_id") @db.Uuid
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  team               Team?                  @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  managedTeams       Team[]                 @relation("TeamManager")
  sessions           Session[]
  accounts           Account[]
  auditLogs          AuditLog[]
  resetRequests      PasswordResetRequest[] @relation("ResetHandledBy")
  leads              Lead[]                 @relation("LeadOwner")
  leadEvents         LeadEvent[]
  accountsOwned      CrmAccount[]           @relation("AccountOwner")
  contactsOwned      Contact[]              @relation("ContactOwner")
  opportunitiesOwned Opportunity[]          @relation("OpportunityOwner")
  opportunityEvents  OpportunityEvent[]
  activitiesAuthored Activity[]             @relation("ActivityAuthor")
  tasksAssigned      Task[]                 @relation("TaskAssignee")
  tasksCreated       Task[]                 @relation("TaskCreator")
  notifications      Notification[]
  importBatches      ImportBatch[]          @relation("ImportCreator")
  integrations       IntegrationConnection[]
  syncEvents         SyncEvent[]
  salesTargets       SalesTarget[]          @relation("TargetOwner")

  @@index([teamId])
  @@index([role])
  @@map("users")
}

model Session {
  id             String   @id @default(uuid(7)) @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  token          String   @unique
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  // Haché par Better Auth (scrypt) : jamais en clair
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model Team {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String   @unique
  managerUserId String?  @map("manager_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  manager User?  @relation("TeamManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  members User[] @relation("TeamMembers")

  @@index([managerUserId])
  @@map("teams")
}

// ---------------------------------------------------------------------------
// Traçabilité et paramétrage
// ---------------------------------------------------------------------------

// Journal d'audit en ajout seul : un trigger PostgreSQL interdit UPDATE et DELETE (voir la migration).
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  // null = action du système (jobs, automatisations)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  requestId   String?  @map("request_id")
  ipAddress   String?  @map("ip_address")
  // Métadonnées autorisées uniquement : jamais de mot de passe, jeton ou donnée sensible
  metadata    Json?

  // Restrict : un utilisateur ayant des traces d'audit ne peut pas être supprimé (on le désactive).
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

// Paramètres applicatifs modifiables par l'administrateur (seuils de bascule, délais d'alerte…).
model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

// Demandes de réinitialisation saisies depuis la page de connexion et traitées par un administrateur.
// L'e-mail n'est volontairement PAS une clé étrangère : la réponse publique est identique que le compte existe ou non.
model PasswordResetRequest {
  id          String    @id @default(uuid(7)) @db.Uuid
  email       String
  status      String    @default("pending") // pending | done | rejected
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  handledById String?   @map("handled_by_id") @db.Uuid
  handledAt   DateTime? @map("handled_at") @db.Timestamptz(3)

  handledBy User? @relation("ResetHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@map("password_reset_requests")
}

// ---------------------------------------------------------------------------
// Phase 3 : prospects (parcours Excel) — voir plan, sections 4 et 5
// ---------------------------------------------------------------------------

// Produits proposés (liste administrable ; valeurs initiales à valider par le métier).
model Product {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  leads         Lead[]
  contactRoles  ContactRole[]
  opportunities Opportunity[]

  @@map("products")
}

// Un prospect = une ligne unique. Les « onglets » de reporting (prospects, qualifiés, propositions, pipeline,
// gagnés) sont des VUES filtrées sur `progress` et `status` : aucune donnée n'est copiée d'un écran à l'autre.
model Lead {
  id                     String    @id @default(uuid(7)) @db.Uuid
  companyName            String    @map("company_name")
  sector                 String
  contactLastName        String    @map("contact_last_name")
  contactFirstName       String    @map("contact_first_name")
  phone                  String
  email                  String
  jobTitle               String    @map("job_title")
  // Date d'insertion saisie par l'utilisateur ; ne peut pas être postérieure à aujourd'hui (contrainte CHECK).
  insertedOn             DateTime  @map("inserted_on") @db.Date
  // « Process de vente » en pourcentage d'avancement : 10, 20, 40, 60, 80, 90 ou 100 (contrainte CHECK).
  progress               Int       @default(10)
  // open | won | lost
  status                 String    @default("open")
  productId              String?   @map("product_id") @db.Uuid
  // Valeur de l'offre commerciale en FCFA (définition du revenu à confirmer : plan, section 12, question 6).
  expectedRevenue        Decimal?  @map("expected_revenue") @db.Decimal(18, 2)
  currency               String    @default("XOF")
  lossReason             String?   @map("loss_reason")
  lossComment            String?   @map("loss_comment")
  closedAt               DateTime? @map("closed_at") @db.Timestamptz(3)
  // Conversion en compte + contact + opportunité (CDC A.8) : le prospect et son historique sont conservés.
  convertedAt            DateTime? @map("converted_at") @db.Timestamptz(3)
  convertedAccountId     String?   @map("converted_account_id") @db.Uuid
  convertedContactId     String?   @map("converted_contact_id") @db.Uuid
  convertedOpportunityId String?   @unique @map("converted_opportunity_id") @db.Uuid
  ownerUserId            String    @map("owner_user_id") @db.Uuid
  // Concurrence optimiste : une modification sur une version périmée est refusée (409).
  version                Int       @default(1)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner   User        @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  product Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)
  events  LeadEvent[]

  convertedAccount     CrmAccount?  @relation("LeadConvertedAccount", fields: [convertedAccountId], references: [id], onDelete: Restrict)
  convertedContact     Contact?     @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: Restrict)
  convertedOpportunity Opportunity? @relation("LeadConvertedOpportunity", fields: [convertedOpportunityId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, status, progress])
  @@index([status, progress])
  @@index([insertedOn])
  @@index([email])
  @@map("leads")
}

// Historique des changements : instantané daté de l'étape, du statut et du montant.
// Alimente les KPI « vs semaine dernière » et la valeur du pipeline reconstituée à une date donnée.
model LeadEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  leadId          String   @map("lead_id") @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  // created | progress_changed | updated | won | lost
  type            String
  fromProgress    Int?     @map("from_progress")
  toProgress      Int      @map("to_progress")
  status          String
  expectedRevenue Decimal? @map("expected_revenue") @db.Decimal(18, 2)

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([leadId, occurredAt])
  @@index([occurredAt, type])
  @@map("lead_events")
}

// ---------------------------------------------------------------------------
// Phase 4.2 : comptes et contacts (CDC sections 3.1 à 3.3 et A.5)
// ---------------------------------------------------------------------------

// Fiche entreprise. Un compte peut avoir un compte parent (groupe) et plusieurs filiales ; la hiérarchie ne doit
// jamais former de cycle (vérifié par le service). Les comptes fusionnés sont archivés, jamais supprimés.
model CrmAccount {
  id                  String    @id @default(uuid(7)) @db.Uuid
  legalName           String    @map("legal_name")
  tradeName           String?   @map("trade_name")
  // RCCM, numéro de compte contribuable ou équivalent local ; unique par pays parmi les comptes non archivés.
  legalIdentifier     String?   @map("legal_identifier")
  sector              String?
  employeeCount       Int?      @map("employee_count")
  // Chiffre d'affaires : montant + devise + année de référence, avec sa source (CDC 3.1).
  revenueAmount       Decimal?  @map("revenue_amount") @db.Decimal(18, 2)
  revenueCurrency     String    @default("XOF") @map("revenue_currency")
  revenueYear         Int?      @map("revenue_year")
  revenueSource       String?   @map("revenue_source")
  collectiveAgreement String?   @map("collective_agreement")
  // prospect | client | inactive | partner
  status              String    @default("prospect")
  // Source d'acquisition : event | referral | campaign | prospecting | other
  source              String?
  phone               String?
  // Domaine de messagerie de l'entreprise (« client.ci ») : sert à détecter les doublons et à rattacher les e-mails.
  emailDomain         String?   @map("email_domain")
  addressLine         String?   @map("address_line")
  city                String?
  country             String    @default("CI")
  parentAccountId     String?   @map("parent_account_id") @db.Uuid
  ownerUserId         String    @map("owner_user_id") @db.Uuid
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(3)
  mergedIntoId        String?   @map("merged_into_id") @db.Uuid
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent         CrmAccount?      @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict)
  children       CrmAccount[]     @relation("AccountHierarchy")
  merged         CrmAccount?      @relation("AccountMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedIn       CrmAccount[]     @relation("AccountMerge")
  owner          User             @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  contacts       AccountContact[]
  opportunities  Opportunity[]
  activities     Activity[]
  tasks          Task[]
  convertedLeads Lead[]           @relation("LeadConvertedAccount")

  @@index([ownerUserId, status])
  @@index([parentAccountId])
  @@index([legalName])
  @@index([emailDomain])
  @@map("accounts_crm")
}

// Personne de contact. Elle peut être rattachée à plusieurs comptes (AccountContact).
model Contact {
  id                  String    @id @default(uuid(7)) @db.Uuid
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  jobTitle            String?   @map("job_title")
  department          String?
  email               String?
  phone               String?
  // active | to_confirm | left
  status              String    @default("active")
  // Canal privilégié : email | phone | whatsapp | in_person
  preferredChannel    String?   @map("preferred_channel")
  // Disponibilités et restrictions de contact (CDC 3.3).
  contactRestrictions String?   @map("contact_restrictions")
  ownerUserId         String    @map("owner_user_id") @db.Uuid
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(3)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner          User                 @relation("ContactOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  accounts       AccountContact[]
  opportunities  OpportunityContact[]
  activities     Activity[]
  tasks          Task[]
  convertedLeads Lead[]               @relation("LeadConvertedContact")

  @@index([ownerUserId])
  @@index([email])
  @@index([lastName, firstName])
  @@map("contacts")
}

// Rattachement d'un contact à un compte (N-N). Un seul contact principal par compte (index partiel en base).
model AccountContact {
  id                String    @id @default(uuid(7)) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  contactId         String    @map("contact_id") @db.Uuid
  relationshipTitle String?   @map("relationship_title")
  isPrimary         Boolean   @default(false) @map("is_primary")
  startDate         DateTime? @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  account CrmAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  contact Contact       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  roles   ContactRole[]

  @@unique([accountId, contactId])
  @@index([contactId])
  @@map("account_contacts")
}

// Rôle d'achat d'un contact chez un compte, éventuellement pour un produit précis (CDC 3.3 : « le rôle d'un contact
// doit être qualifié par famille de produits »). Le rattachement à une opportunité s'ajoutera au sprint 4.3.
model ContactRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  // decision_maker | validator | buyer | prescriber | user | other
  roleType  String   @map("role_type")
  productId String?  @map("product_id") @db.Uuid
  // high | medium | low
  influence String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Un rôle n'existe que pour un contact réellement rattaché au compte ; il disparaît avec le rattachement.
  link    AccountContact @relation(fields: [accountId, contactId], references: [accountId, contactId], onDelete: Cascade)
  product Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([accountId, contactId])
  @@map("contact_roles")
}

// ---------------------------------------------------------------------------
// Phase 4.3 : opportunités et pipeline (CDC sections 5.1 à 5.4 et A.5)
// ---------------------------------------------------------------------------

// Une opportunité = une affaire commerciale chez un compte. Le montant PONDÉRÉ n'est jamais stocké : il est calculé
// côté serveur (montant × probabilité de l'étape). L'étape est un pourcentage d'avancement (10, 20, 40, 60, 80, 90) ;
// 100 % = gagné. Même échelle que les prospects (Excel et CDC 5.2).
model Opportunity {
  id                String    @id @default(uuid(7)) @db.Uuid
  name              String
  accountId         String    @map("account_id") @db.Uuid
  ownerUserId       String    @map("owner_user_id") @db.Uuid
  productId         String?   @map("product_id") @db.Uuid
  amount            Decimal   @default(0) @db.Decimal(18, 2)
  currency          String    @default("XOF")
  // Période de revenu du montant : one_time | monthly | annual (la définition du revenu reste à confirmer, plan §12).
  revenuePeriod     String    @default("annual") @map("revenue_period")
  estimationMethod  String?   @map("estimation_method")
  stage             Int       @default(10)
  // open | won | lost
  status            String    @default("open")
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  // Prochaine action datée : obligatoire tant que l'opportunité est ouverte (CDC 5.1 et 14).
  nextAction        String?   @map("next_action")
  nextActionDate    DateTime? @map("next_action_date") @db.Date
  competitor        String?
  currentSolution   String?   @map("current_solution")
  lossReason        String?   @map("loss_reason")
  lossComment       String?   @map("loss_comment")
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(3)
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account       CrmAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  owner         User                 @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  product       Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)
  contacts      OpportunityContact[]
  events        OpportunityEvent[]
  activities    Activity[]
  tasks         Task[]
  convertedFrom Lead[]               @relation("LeadConvertedOpportunity")

  @@index([ownerUserId, status, stage])
  @@index([accountId])
  @@index([status, expectedCloseDate])
  @@map("opportunities")
}

// Contacts impliqués dans l'opportunité, avec leur rôle dans CE dossier (CDC 5.1).
model OpportunityContact {
  id            String   @id @default(uuid(7)) @db.Uuid
  opportunityId String   @map("opportunity_id") @db.Uuid
  contactId     String   @map("contact_id") @db.Uuid
  // decision_maker | validator | buyer | prescriber | user | other
  roleType      String?  @map("role_type")
  isMain        Boolean  @default(false) @map("is_main")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([opportunityId, contactId])
  @@index([contactId])
  @@map("opportunity_contacts")
}

// Historique daté des changements d'étape, de montant et de date de clôture : il explique les variations du forecast.
model OpportunityEvent {
  id                String    @id @default(uuid(7)) @db.Uuid
  opportunityId     String    @map("opportunity_id") @db.Uuid
  occurredAt        DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId       String?   @map("actor_user_id") @db.Uuid
  // created | stage_changed | updated | won | lost
  type              String
  fromStage         Int?      @map("from_stage")
  toStage           Int       @map("to_stage")
  status            String
  amount            Decimal   @db.Decimal(18, 2)
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([opportunityId, occurredAt])
  @@index([occurredAt, type])
  @@map("opportunity_events")
}

// Activité journalisée (CDC 6.1) : appel, e-mail, rendez-vous… Liée à un compte et, selon le cas, à un contact et
// une opportunité. L'origine distingue la saisie utilisateur, la synchronisation et l'automatisation (CDC 3.4).
model Activity {
  id             String    @id @default(uuid(7)) @db.Uuid
  // call_in | call_out | email | meeting | video | note | proposal_sent | contract_step
  type           String
  subject        String
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(3)
  authorUserId   String    @map("author_user_id") @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  opportunityId  String?   @map("opportunity_id") @db.Uuid
  outcome        String?
  nextAction     String?   @map("next_action")
  nextActionDate DateTime? @map("next_action_date") @db.Date
  // user | sync | automation
  origin         String    @default("user")
  // Activité issue d'une synchronisation : fournisseur, identifiant technique du message (dédoublonnage) et lien
  // vers l'élément d'origine. Un message vu par plusieurs comptes donne une activité par compte.
  externalProvider String? @map("external_provider")
  externalId       String? @map("external_id")
  externalUrl      String? @map("external_url")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  author      User         @relation("ActivityAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  account     CrmAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Restrict)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  @@index([accountId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([contactId])
  @@index([authorUserId, occurredAt])
  @@map("activities")
}

// Tâche (CDC 6) : toute tâche ouverte a un responsable. Liée à un objet métier (compte, contact, opportunité).
model Task {
  id              String    @id @default(uuid(7)) @db.Uuid
  title           String
  description     String?
  dueDate         DateTime  @map("due_date") @db.Date
  // open | done | cancelled
  status          String    @default("open")
  // low | normal | high
  priority        String    @default("normal")
  assigneeUserId  String    @map("assignee_user_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  accountId       String?   @map("account_id") @db.Uuid
  contactId       String?   @map("contact_id") @db.Uuid
  opportunityId   String?   @map("opportunity_id") @db.Uuid
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  // user | automation (les tâches créées par les relances automatiques)
  origin          String    @default("user")
  // Clé d'idempotence d'une tâche automatique (règle + objet + période) : un second passage ne la recrée pas.
  automationKey   String?   @unique @map("automation_key")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignee    User         @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  createdBy   User         @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  account     CrmAccount?  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Restrict)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  @@index([assigneeUserId, status, dueDate])
  @@index([accountId])
  @@index([opportunityId])
  @@map("tasks")
}

// Règle de relance automatique (CDC 6.2) : activable, désactivable, paramétrable. Les lignes sont créées par la
// migration (une par règle connue) ; l'administrateur modifie `enabled` et `params`.
model AutomationRule {
  id              String   @id @default(uuid(7)) @db.Uuid
  // inactivity | no_next_action | close_date_overdue | meeting_soon | task_overdue
  code            String   @unique
  enabled         Boolean  @default(true)
  params          Json
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("automation_rules")
}

// Journal d'exécution : chaque passage d'une règle, avec ce qu'il a évalué, créé et ignoré (CDC 6.2 : « journalisée »).
model AutomationRun {
  id                   String    @id @default(uuid(7)) @db.Uuid
  ruleCode             String    @map("rule_code")
  // manual | schedule
  trigger              String
  startedAt            DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime? @map("finished_at") @db.Timestamptz(3)
  // running | success | error
  status               String    @default("running")
  evaluated            Int       @default(0)
  tasksCreated         Int       @default(0) @map("tasks_created")
  notificationsCreated Int       @default(0) @map("notifications_created")
  // Éléments déjà traités pour la période : ignorés grâce aux clés d'idempotence.
  skipped              Int       @default(0)
  error                String?
  startedByUserId      String?   @map("started_by_user_id") @db.Uuid

  @@index([ruleCode, startedAt])
  @@index([startedAt])
  @@map("automation_runs")
}

// Notification visible dans le CRM (CDC 6.3). Une seule par destinataire et par clé : c'est la politique anti-spam
// (regroupement des alertes similaires, fréquence maximale par période).
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Règle d'origine (ou « owner_changed », « task_reassigned »).
  source    String
  title     String
  body      String?
  href      String
  // Nombre d'éléments regroupés dans cette notification.
  itemCount Int       @default(1) @map("item_count")
  dedupeKey String    @map("dedupe_key")
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// Connexion d'un utilisateur à un fournisseur externe (CDC 7). Les jetons ne sont JAMAIS stockés en clair : ils sont
// chiffrés (AES-256-GCM) avec une clé qui ne figure pas en base. Un utilisateur a au plus une connexion par fournisseur.
model IntegrationConnection {
  id                   String    @id @default(uuid(7)) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  // microsoft
  provider             String
  // active | needs_reconnect | revoked
  status               String    @default("active")
  // Adresse du compte connecté (affichage, et exclusion des propres adresses lors du rapprochement).
  accountEmail         String?   @map("account_email")
  externalUserId       String?   @map("external_user_id")
  // Droits accordés (moindre privilège : lecture des en-têtes de messages seulement).
  scopes               String
  accessTokenEnc       String?   @map("access_token_enc")
  refreshTokenEnc      String?   @map("refresh_token_enc")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  // Curseurs de synchronisation incrémentale par dossier (« delta »).
  cursors              Json      @default("{}")
  // Date à partir de laquelle les messages sont importés (première synchronisation bornée).
  syncSince            DateTime  @map("sync_since") @db.Timestamptz(3)
  // Verrou : une seule synchronisation à la fois par connexion.
  syncingSince         DateTime? @map("syncing_since") @db.Timestamptz(3)
  // Demandée par une notification du fournisseur (webhook) : traitée par la prochaine exécution.
  syncRequestedAt      DateTime? @map("sync_requested_at") @db.Timestamptz(3)
  lastSyncAt           DateTime? @map("last_sync_at") @db.Timestamptz(3)
  lastSuccessAt        DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastError            String?   @map("last_error")
  // Abonnement aux notifications du fournisseur (webhooks) et secret de vérification des appels reçus.
  subscriptionId       String?   @map("subscription_id")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at") @db.Timestamptz(3)
  webhookSecret        String?   @map("webhook_secret")
  consentedAt          DateTime  @map("consented_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events SyncEvent[]

  @@unique([userId, provider])
  @@unique([subscriptionId])
  @@index([provider, status])
  @@map("integration_connections")
}

// Journal des synchronisations (CDC 7.3 : fournisseur, statut, dernière tentative ; REC-07, 08 et 11).
model SyncEvent {
  id           String    @id @default(uuid(7)) @db.Uuid
  connectionId String?   @map("connection_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String
  // mail_sync | connected | disconnected | token_refresh | webhook | subscription
  kind         String
  // manual | schedule | webhook | system
  trigger      String
  // running | success | partial | error
  status       String    @default("running")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)
  // Messages lus, importés (activités créées), écartés (sans correspondance, exclus, brouillons) et déjà connus.
  fetched      Int       @default(0)
  imported     Int       @default(0)
  skipped      Int       @default(0)
  duplicates   Int       @default(0)
  error        String?

  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([userId, startedAt])
  @@map("sync_events")
}

// Jeton de protection (« state » + vérificateur PKCE) d'une connexion OAuth en cours : à usage unique, valable quelques minutes.
model OAuthState {
  state        String   @id
  userId       String   @map("user_id") @db.Uuid
  provider     String
  codeVerifier String   @map("code_verifier")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("oauth_states")
}

// Import initial de données (CDC 11 et 14) : un lot = un fichier déposé, avec son mapping, son rapport de qualité et
// ses lignes. Rien n'est écrit dans les comptes ou contacts avant la confirmation explicite de l'administrateur.
model ImportBatch {
  id              String    @id @default(uuid(7)) @db.Uuid
  // accounts | contacts
  entity          String
  filename        String
  // uploaded | analyzed | importing | imported | cancelled
  status          String    @default("uploaded")
  // En-têtes du fichier, dans l'ordre des colonnes.
  headers         Json
  // Champ du CRM → nom de la colonne du fichier.
  mapping         Json?
  // Valeurs par défaut (responsable, secteur, statut, pays…).
  defaults        Json?
  // Rapport de qualité : rejets, doublons, champs manquants.
  report          Json?
  totalRows       Int       @map("total_rows")
  validRows       Int       @default(0) @map("valid_rows")
  rejectedRows    Int       @default(0) @map("rejected_rows")
  duplicateRows   Int       @default(0) @map("duplicate_rows")
  importedRows    Int       @default(0) @map("imported_rows")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  analyzedAt      DateTime? @map("analyzed_at") @db.Timestamptz(3)
  importedAt      DateTime? @map("imported_at") @db.Timestamptz(3)

  creator User        @relation("ImportCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  rows    ImportRow[]

  @@index([createdAt])
  @@map("import_batches")
}

model ImportRow {
  id              String  @id @default(uuid(7)) @db.Uuid
  batchId         String  @map("batch_id") @db.Uuid
  // Numéro de la ligne dans le fichier (l'en-tête est la ligne 1).
  rowNumber       Int     @map("row_number")
  // Cellules d'origine, alignées sur les en-têtes. Vidé une fois la ligne importée (minimisation des données).
  raw             Json
  // pending | valid | rejected | duplicate | imported
  status          String  @default("pending")
  // Valeurs normalisées prêtes à être importées.
  parsed          Json?
  // Motifs de rejet (liste de messages).
  errors          Json?
  duplicateOf     String? @map("duplicate_of")
  // Compte ou contact créé par cette ligne : traçabilité de l'import.
  createdEntityId String? @map("created_entity_id") @db.Uuid

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@map("import_rows")
}

// Objectif commercial MENSUEL d'un commercial (CDC 8.2), comparé au forecast. Un objectif trimestriel ou annuel n'est
// jamais saisi : c'est la somme des mois, ce qui évite des niveaux incohérents entre eux. Montant annualisé, en XOF.
model SalesTarget {
  id          String   @id @default(uuid(7)) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  // Premier jour du mois (contrainte en base).
  periodStart DateTime @map("period_start") @db.Date
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("XOF")
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner User @relation("TargetOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, periodStart])
  @@index([periodStart])
  @@map("sales_targets")
}
