# Copier ce fichier en .env puis remplacer les valeurs. Ne jamais committer .env.

# --- Base de données (conteneur Docker local, voir docker-compose.yml) ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm
POSTGRES_PORT=5435
DATABASE_URL=postgresql://crm:change-me@localhost:5435/crm

# --- Authentification (Better Auth) ---
# Secret d'au moins 32 caractères : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-with-a-long-random-secret
# URL publique de l'application (sans slash final)
BETTER_AUTH_URL=http://localhost:3100

# --- Compte administrateur initial (utilisé uniquement par `npm run db:seed`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Administrateur CRM
SEED_ADMIN_PASSWORD=change-me-too

# --- Application ---
NODE_ENV=development
LOG_LEVEL=info

# Secret du planificateur (cron) qui appelle POST /api/jobs/automations avec « Authorization: Bearer <secret> ».
# Au moins 32 caractères : openssl rand -base64 32. S'il est absent, la route répond 404 (désactivée).
# CRON_SECRET=change-me-with-a-long-random-secret

# Comptes de démonstration (un par rôle, développement uniquement, jamais créés en production)
# SEED_DEMO_PASSWORD=change-me-demo-1

# Base dédiée aux tests d'intégration (créer la base crm_test puis : prisma migrate deploy)
# TEST_DATABASE_URL=postgresql://crm:change-me@localhost:5435/crm_test
